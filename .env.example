# AgentFleet Configuration
APP_NAME="AgentFleet API"
APP_ENV="development" # development, staging, production
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Supabase API Credentials
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"

-- Supabase PostgreSQL Connection URL (transaction pooler recommended for serverless)
SUPABASE_DB_URL="postgresql+psycopg2://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
