# AgentFleet Configuration
APP_NAME="AgentFleet API"
APP_ENV="development" # development, staging, production
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Supabase PostgreSQL Database Settings
# URL format: postgresql+psycopg2://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql+psycopg2://postgres:your-db-password@your-project-ref.supabase.co:5432/postgres"

# Supabase API Settings
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-anon-or-service-key"
